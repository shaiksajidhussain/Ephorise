# Production origin for canonical URLs, Open Graph, sitemap, and robots.
# Use the live https origin. Localhost is ignored on purpose.
# On Vercel this falls back to the project production domain when unset.
# Set it when the public site should use a different domain.
# NEXT_PUBLIC_SITE_URL=https://ephorise.vercel.app

# Optional public email. Shown in the footer and on the contact page only when set.
# NEXT_PUBLIC_PUBLIC_EMAIL=hello@your-domain.example

# Server-only HTTPS endpoint that receives inquiry JSON.
# Use a private Slack, Zapier, Make, or custom endpoint.
# Never prefix this with NEXT_PUBLIC_.
# In local development, http://127.0.0.1 and http://localhost are also accepted.
# CONTACT_WEBHOOK_URL=https://hooks.example.com/services/your-private-path
